[Unit]
Description=RTSP infer stream (RKNN draw + MPP hard encode + MediaMTX push)
Wants=mediamtx.service
After=mediamtx.service

[Service]
Type=simple
User=orangepi
WorkingDirectory=/home/orangepi/trash_detect/scripts
ExecStart=/usr/bin/python3 /home/orangepi/trash_detect/scripts/rtsp_infer_stream.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
