[Unit]
Description=OLED temperature monitor (SSD1306)
After=multi-user.target

[Service]
Type=simple
User=orangepi
SupplementaryGroups=i2c
ExecStart=/usr/bin/python3 /home/orangepi/trash_detect/scripts/thermal_monitor.py --interval 4
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
